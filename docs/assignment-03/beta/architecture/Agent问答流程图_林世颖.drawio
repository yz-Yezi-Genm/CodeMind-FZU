          <mxGeometry x="560" y="56" width="480" height="46" as="geometry" />
        </mxCell>
        <mxCell id="n1" value="POST /api/v1/ask（query、conversation_id）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#34a853;fontColor=#333333;fontSize=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="560" y="122" width="480" height="46" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="后端接收请求；会话存储按 conversation_id 读取历史&#10;构造 AgentRequest 交给 Agent 工作流" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#34a853;fontColor=#333333;fontSize=11;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="560" y="188" width="480" height="52" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="Agent 识别 S1—S4 业务场景" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#9c27b0;fontColor=#333333;fontSize=13;fontStyle=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="560" y="260" width="480" height="46" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="必要信息是否充分？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#9c27b0;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="620" y="326" width="360" height="64" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="Retriever.retrieve()：BM25 检索排序&#10;方向不确定时不传 business_direction_code，全库检索" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#9c27b0;fontColor=#333333;fontSize=11;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="560" y="426" width="480" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="来源 / 适用范围 / 审核状态 / 时效检查（证据门禁）&#10;历史资料按问题时间范围选择并标注 historical，不得冒充现行政策" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#9c27b0;fontColor=#333333;fontSize=11;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="560" y="494" width="480" height="62" as="geometry" />
        </mxCell>
        <mxCell id="n7" value="合格证据交给 Qwen（受约束生成）&#10;Agent 分配临时 evidence_id 并保存与真实片段的映射" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9ab00;fontColor=#333333;fontSize=11;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="560" y="574" width="480" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n8" value="Agent 校验模型输出&#10;JSON 格式 · answer 非空 · ID 存在且属于本次门禁集合" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9ab00;fontColor=#333333;fontSize=11;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="560" y="642" width="480" height="56" as="geometry" />
        </mxCell>
        <mxCell id="n9" value="Agent 按真实检索片段构造 Citation&#10;模型不自行创建 Citation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#34a853;fontColor=#333333;fontSize=11;arcSize=10;" vertex="1" parent="1">
