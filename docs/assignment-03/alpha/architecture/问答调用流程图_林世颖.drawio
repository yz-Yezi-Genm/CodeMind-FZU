        <mxCell id="n0" value="学生提问（浏览器）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#34a853;fontColor=#333333;fontSize=13;fontStyle=1;arcSize=10;" vertex="1" parent="1">
