          <mxGeometry x="620" y="855" width="360" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n11" value="AgentResult 由后端包装为 AskResponse" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#34a853;fontColor=#333333;fontSize=12;arcSize=10;" vertex="1" parent="1">
