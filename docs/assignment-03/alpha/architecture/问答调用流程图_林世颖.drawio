        </mxCell>
        <mxCell id="n1" value="POST /api/v1/ask（query、conversation_id）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#34a853;fontColor=#333333;fontSize=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="560" y="140" width="480" height="48" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="后端校验；会话存储按 conversation_id 载入历史，构造 AgentRequest" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#34a853;fontColor=#333333;fontSize=11;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="560" y="210" width="480" height="52" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="Agent 工作流：业务规则判断意图与信息完整性" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#9c27b0;fontColor=#333333;fontSize=13;fontStyle=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="560" y="290" width="480" height="48" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="信息是否充分？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#9c27b0;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="620" y="360" width="360" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="Retriever.retrieve()：BM25 检索排序&#10;仅筛选 enabled 资料；不做来源/时效/人工审核核验" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#9c27b0;fontColor=#333333;fontSize=11;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="560" y="470" width="480" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="AgentWorkflow._eligible() 资格核验&#10;来源/时效/生效日期/人工审核标记/元数据一致性" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#9c27b0;fontColor=#333333;fontSize=11;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="560" y="540" width="480" height="56" as="geometry" />
        </mxCell>
        <mxCell id="n7" value="alpha_evidence_check 业务适用判断&#10;证据是否符合当前问题的业务适用范围" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#9c27b0;fontColor=#333333;fontSize=11;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="560" y="616" width="480" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n8" value="是否有可用证据？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#9c27b0;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="620" y="690" width="360" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n9" value="LLMClient.generate() 选取证据摘录，模型输出不作为证据" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#9c27b0;fontColor=#333333;fontSize=11;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="560" y="780" width="480" height="48" as="geometry" />
        </mxCell>
