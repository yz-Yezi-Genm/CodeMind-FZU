        uuid id PK "required"
        uuid version_id FK "required"
    }
    document_file_sources {
        uuid file_id PK,FK "required"
        uuid source_file_id PK,FK "required"
        uuid version_id FK "required"
    }
    document_version_relations {
        uuid from_version_id PK,FK "required"
        uuid to_version_id PK,FK "required"
        string relation_type PK "required"
    }
