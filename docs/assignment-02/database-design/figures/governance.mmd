    business_directions {
        uuid id PK "required"
    }
    document_business_directions {
        uuid document_id PK,FK "required"
        uuid direction_id PK,FK "required"
    }
    verification_records {
        uuid id PK "required"
        uuid version_id FK "required"
        uuid file_id FK "nullable"
    }
    verification_tasks {
        uuid id PK "required"
        uuid version_id FK "required"
        uuid file_id FK "nullable"
        uuid completion_record_id FK "nullable"
    }
