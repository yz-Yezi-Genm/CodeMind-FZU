erDiagram
    %% v1.2审核基线：23表。列出主外键、唯一键字段及部分说明性字段，完整类型和索引见详细设计。
    %% 关系标签为子表外键字段组合；同一条复合外键不可拆为多个独立外键。
    %% 1对0..N；o|表示该外键可空。所有图示外键删除规则均为RESTRICT。
    knowledge_categories {
        uuid id PK "not_null"
        string name UK "not_null"
    }
    knowledge_documents {
        uuid id PK "not_null"
        uuid category_id FK "not_null"
        string title "not_null"
    }
    document_versions {
        uuid id PK "not_null"
        uuid document_id FK "not_null"
        string record_code UK "not_null"
        string version_no "not_null"
        string source_url "not_null"
        string source_verification_status "not_null"
        string timeliness_verification_status "not_null"
        string extraction_status "not_null"
        string retrieval_status "not_null"
    }
    %% UNIQUE document_versions(document_id, version_no)
    document_files {
        uuid id PK "not_null"
        uuid version_id FK "not_null"
        string file_role "not_null"
        string storage_key UK "not_null"
    }
    %% UNIQUE document_files(id, version_id)
    applicability_rules {
        uuid id PK "not_null"
        uuid version_id FK "not_null"
        string purpose "not_null"
        string enrollment_mode "not_null"
        string graduation_mode "not_null"
        string major_mode "not_null"
        string student_type_mode "not_null"
    }
    applicability_rule_values {
        uuid rule_id PK,FK "not_null"
        string dimension PK "not_null"
        string value PK "not_null"
    }
    knowledge_chunks {
        uuid id PK "not_null"
        uuid version_id FK "not_null"
        uuid file_id FK "not_null"
        integer chunk_no "not_null"
        string content "not_null"
        string locator "nullable"
        uuid original_file_id FK "nullable"
        string original_locator "nullable"
        string index_status "not_null"
    }
    %% UNIQUE knowledge_chunks(file_id, chunk_no)
    %% UNIQUE knowledge_chunks(id, version_id)
    business_directions {
        uuid id PK "not_null"
        string code UK "not_null"
        string name UK "not_null"
        string delivery_stage "not_null"
    }
    document_business_directions {
        uuid document_id PK,FK "not_null"
        uuid direction_id PK,FK "not_null"
    }
    verification_records {
        uuid id PK "not_null"
        uuid version_id FK "not_null"
        uuid file_id FK "nullable"
    }
    %% UNIQUE verification_records(id, version_id)
    %% UNIQUE verification_records(id, version_id, file_id)
    verification_tasks {
        uuid id PK "not_null"
        uuid version_id FK "not_null"
        uuid file_id FK "nullable"
        uuid completion_record_id FK "nullable"
    }
    %% UNIQUE verification_tasks(id, version_id)
    users {
        uuid id PK "not_null"
        string external_subject UK "nullable"
    }
    conversation_sessions {
        uuid id PK "not_null"
        uuid user_id FK "nullable"
    }
    interaction_messages {
        uuid id PK "not_null"
        uuid session_id FK "not_null"
        integer sequence_no "not_null"
        string role "not_null"
    }
    %% UNIQUE interaction_messages(id, session_id, role)
    %% UNIQUE interaction_messages(session_id, sequence_no)
    agent_tasks {
        uuid id PK "not_null"
        uuid request_message_id FK "not_null"
        uuid session_id FK "not_null"
        string request_role FK "not_null"
    }
    %% UNIQUE agent_tasks(id, session_id)
    task_results {
        uuid id PK "not_null"
        uuid task_id FK "not_null"
        uuid session_id FK "not_null"
        integer result_no "not_null"
    }
    %% UNIQUE task_results(id, session_id)
    %% UNIQUE task_results(task_id, result_no)
    result_citations {
        uuid id PK "not_null"
        uuid result_id FK "not_null"
        integer citation_no "not_null"
        uuid version_id FK "not_null"
        uuid chunk_id FK "nullable"
    }
    %% UNIQUE result_citations(result_id, citation_no)
    document_milestones {
        uuid id PK "not_null"
        uuid version_id FK "not_null"
    }
    document_file_sources {
        uuid file_id PK,FK "not_null"
        uuid source_file_id PK,FK "not_null"
        uuid version_id FK "not_null"
    }
    message_result_links {
        uuid message_id PK,FK "not_null"
        uuid result_id PK,FK "not_null"
        uuid session_id FK "not_null"
        string message_role FK "not_null"
    }
    document_version_relations {
        uuid from_version_id PK,FK "not_null"
        uuid to_version_id PK,FK "not_null"
        string relation_type PK "not_null"
    }
    answer_feedback {
        uuid id PK "not_null"
        uuid message_id FK "not_null"
        uuid session_id FK "not_null"
        string message_role FK "not_null"
        uuid version_id FK "nullable"
    }
    %% UNIQUE answer_feedback(id, version_id)
    feedback_review_links {
        uuid feedback_id PK,FK "not_null"
        uuid verification_task_id PK,FK "not_null"
        uuid version_id FK "not_null"
    }
