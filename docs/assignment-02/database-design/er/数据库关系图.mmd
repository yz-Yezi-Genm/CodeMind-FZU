    conversation_sessions ||--o{ interaction_messages : session_id
    interaction_messages ||--o{ agent_tasks : request_message_id_session_id_request_role
    conversation_sessions ||--o{ agent_tasks : session_id
    conversation_sessions ||--o{ task_results : session_id
    agent_tasks ||--o{ task_results : task_id_session_id
    knowledge_chunks o|--o{ result_citations : chunk_id_version_id
    task_results ||--o{ result_citations : result_id
    document_versions ||--o{ result_citations : version_id
    document_versions ||--o{ document_milestones : version_id
