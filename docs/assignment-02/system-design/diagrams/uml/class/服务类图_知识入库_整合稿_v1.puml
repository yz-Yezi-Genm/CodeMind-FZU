@startuml
skinparam defaultFontName "Microsoft YaHei"
skinparam defaultFontSize 13
skinparam classAttributeIconSize 0
skinparam nodesep 30
skinparam ranksep 40
hide circle
title CodeMind-FZU 知识入库与索引类图（整合稿）

package "资料采集与登记" {
  class MetadataGate {
    + check(metadata) : bool
  }
  class ParserOCR {
    + parse(file) : Text
    + markOCR(file) : bool
  }
  class LocalKnowledge {
    + saveRaw(file)
    + saveClean(text)
  }
  class IndexCSV {
    + update(record)
  }
}

package "分块与索引构建" {
  class ChunkBuilder {
    + chunk(version) : Chunks
  }
  class ChromaBuilder {
    + build(versionId) : IndexStatus
  }
  class BM25Builder {
    + build(versionId) : IndexStatus
  }
  class QualityGate {
    + gate(version) : bool
  }
  class PoCTestSuite {
    + run(version) : Report
  }
}

package "发布与读取" {
  class IndexPublisher {
    + publish(version) : void
  }
  class VersionRegistry {
    + bind(versionId) : void
    + switch(versionId) : void
  }
  class AgentQueryGateway {
    + activeIndex() : Index
  }
}

MetadataGate --> LocalKnowledge : save
ParserOCR --> LocalKnowledge : save
MetadataGate --> IndexCSV : update
ChunkBuilder --> LocalKnowledge : read
ChunkBuilder --> ChromaBuilder : chunks
ChunkBuilder --> BM25Builder : chunks
QualityGate --> ChromaBuilder : status
QualityGate --> BM25Builder : status
QualityGate --> PoCTestSuite : run
PoCTestSuite --> IndexPublisher : pass
IndexPublisher --> VersionRegistry : bind
VersionRegistry --> AgentQueryGateway : activeIndex

@enduml
