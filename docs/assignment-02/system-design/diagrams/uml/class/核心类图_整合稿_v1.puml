@startuml
skinparam defaultFontName "Microsoft YaHei"
skinparam defaultFontSize 13
skinparam classAttributeIconSize 0
skinparam nodesep 22
skinparam ranksep 34
hide circle
title CodeMind-FZU 核心领域类图（整合稿 · 对齐 ORM）

class User {
  + id : UUID
  + external_subject : str
  + display_name : str
  + status : str
}
class ConversationSession {
  + id : UUID
  + user_id : UUID [可空]
  + title : str
  + started_at : datetime
}
class InteractionMessage {
  + id : UUID
  + sequence_no : int
  + role : str
  + content : text
}
class AgentTask {
  + id : UUID
  + request_message_id : UUID
  + task_type : str
  + status : str
}
class TaskResult {
  + id : UUID
  + result_stage : str
  + answer_mode : str
  + content : text
}
class ResultCitation {
  + id : UUID
  + version_id : UUID
  + chunk_id : UUID [可空]
  + locator : str
}
class AnswerFeedback {
  + id : UUID
  + version_id : UUID [可空]
  + feedback_type : str
  + status : str
}
class KnowledgeCategory {
  + id : UUID
  + name : str
  + sort_order : int
}
class KnowledgeDocument {
  + id : UUID
  + title : str
  + document_type : str
}
class DocumentVersion {
  + id : UUID
  + version_no : str
  + policy_status : str
  + source_verification_status : str
  + timeliness_verification_status : str
  + retrieval_status : str
}
class DocumentFile {
  + id : UUID
  + file_role : str
  + sha256 : str
}
class ApplicabilityRule {
  + id : UUID
  + purpose : str
  + verification_status : str
}
class KnowledgeChunk {
  + id : UUID
  + content : text
  + locator : str
  + index_status : str
}
class VerificationRecord {
  + id : UUID
  + check_type : str
  + outcome : str
  + checked_on : date
}

User "0..1" -- "*" ConversationSession : user_id 可空，支持匿名会话
ConversationSession "1" -- "*" InteractionMessage
InteractionMessage "1" -- "*" AgentTask : 触发
AgentTask "1" -- "*" TaskResult
TaskResult "1" -- "*" ResultCitation
ResultCitation "*" -- "1" DocumentVersion : 引用确定版本
ResultCitation "*" -- "0..1" KnowledgeChunk : 精确片段可选
InteractionMessage "1" -- "*" AnswerFeedback : 反馈
KnowledgeCategory "1" -- "*" KnowledgeDocument
KnowledgeDocument "1" -- "*" DocumentVersion
DocumentVersion "1" -- "*" DocumentFile
DocumentVersion "1" -- "*" ApplicabilityRule
DocumentVersion "1" -- "*" KnowledgeChunk
DocumentFile "1" -- "*" KnowledgeChunk : 来源
DocumentVersion "1" -- "*" VerificationRecord

@enduml
