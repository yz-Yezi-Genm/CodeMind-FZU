@startuml 系统用例图
' ============================================
' CodeMind-FZU 系统用例图
' 负责人：颜俊宇  版本：v3.3
' 建模原则：先定边界 → 再定参与者(角色) → 用例=用户目标 → 关系能少则少
' 业务范围：对齐整体功能蓝图五大方向，首版优先支持前四个方向的有资料依据查询与导航；
'           竞赛认定/奖学金申请/推免基本条件为三个代表性测试任务
' ============================================

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Microsoft YaHei"
skinparam packageStyle rectangle

skinparam package {
  BackgroundColor #F7F9FC
  BorderColor #3949AB
  BorderThickness 2
  FontColor #1A237E
  FontStyle bold
  FontSize 20
}

skinparam actor {
  BackgroundColor #E8EAF6
  BorderColor #3949AB
  BorderThickness 2
  FontColor #1A237E
  FontStyle bold
  FontSize 15
}

skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #5C6BC0
  BorderThickness 2
  FontColor #212121
  FontSize 15
}

skinparam ArrowColor #78909C
skinparam ArrowFontColor #78909C
skinparam ArrowFontSize 12
skinparam ArrowThickness 1.5

hide empty members
left to right direction

' ============ 参与者（角色，标准 actor 符号） ============
actor "学生\n（查询者）" as Student
actor "知识库管理员\n（内容维护者）" as KbAdmin

' ============ 系统边界 ============
rectangle "CodeMind-FZU 系统\n校园事务与发展信息查询助手" as System {

  ' ---- 抽象基用例（统一查询目标，abstract 标识） ----
  usecase "查询校园事务信息\n<<abstract>>" as UC_Query

  ' ---- 查询类用例（对齐蓝图前四方向） ----
  usecase "查询竞赛认定信息" as UC_Competition
  usecase "查询奖学金申请信息" as UC_Scholarship
  usecase "查询推免条件" as UC_Postgrad
  usecase "查询学院资源信息" as UC_Resource

  ' ---- 扩展交互（作业要求体现的交互） ----
  usecase "补充信息追问" as UC_Followup
  usecase "查看回答依据" as UC_Evidence

  ' ---- 学生反馈 ----
  usecase "反馈回答问题" as UC_Feedback

  ' ---- 知识库管理员目标 ----
  usecase "维护知识库资料" as UC_KB
  usecase "核验资料时效与来源" as UC_Verify
}

' ============ 关联（普通实线，无箭头） ============
Student -- UC_Query
Student -- UC_Feedback
KbAdmin -- UC_KB
KbAdmin -- UC_Verify

' ============ 布局约束：学生拉到左侧 ============
Student -[hidden]down- UC_Competition

' ============ 泛化：场景查询是「查询校园事务信息」的特例 ============
UC_Competition --|> UC_Query
UC_Scholarship --|> UC_Query
UC_Postgrad --|> UC_Query
UC_Resource --|> UC_Query

' ============ extend：可选交互扩展自查询 ============
UC_Followup ..> UC_Query : <<extend>>
UC_Evidence ..> UC_Query : <<extend>>

' ============ include：维护必然包含核验 ============
UC_KB ..> UC_Verify : <<include>>

legend bottom right
  | 关系图例 |
  | 关联 —— 参与者与用例交互（实线无箭头） |
  | 泛化 △ 场景查询是「查询校园事务信息」的特例 |
  | <<extend>> 可选扩展交互 |
  | <<include>> 必然包含的用例 |
  | <<abstract>> 抽象基用例，不独立交付 |
  | 竞赛认定 / 奖学金 / 推免 = 代表性测试任务 |
endlegend

@enduml
