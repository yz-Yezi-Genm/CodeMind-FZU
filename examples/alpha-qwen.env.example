# Supplement for the team's backend/.env during real Qwen integration.
# Keep the existing CORS/ALPHA_PACKAGE_DIR/conversation settings when merging.
# No credentials are included. The account owner sets QWEN_API_KEY locally.
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-flash
# qwen-plus is an explicit alternative; do not auto-switch on failures.
QWEN_TIMEOUT_SECONDS=28
QWEN_MAX_RETRIES=0
# AgentWorkflow keeps its 30-second outer generate wait.
# httpx's timeout is not a guaranteed total duration; the outer wait is required.
