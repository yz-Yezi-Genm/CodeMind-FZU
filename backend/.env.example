# Comma-separated browser origins. Do not use "*".
# Defaults cover Vite (5173), Node-style dev servers (3000), and Live Server (5500).
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500

# Qwen OpenAI-compatible endpoint. Keep the API key only in local environment.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
QWEN_TIMEOUT_SECONDS=28
QWEN_MAX_RETRIES=0

# Alpha loads only enabled DocumentPackage JSON files from this directory.
# Relative paths are resolved from the repository root. Test fixtures must not
# be used as the production corpus.
ALPHA_PACKAGE_DIR=knowledge_base/processed/alpha/approved

# Per-conversation server-side memory. Histories are isolated by conversation_id
# and trimmed to the most recent complete exchanges.
CONVERSATION_MAX_MESSAGES=12
CONVERSATION_HISTORY_CHAR_LIMIT=6000
