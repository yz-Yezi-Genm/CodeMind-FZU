# ============================================================
# CodeMind-FZU 后端环境变量模板（Beta 本机运行）
#
# 用法：
#   1) 复制为 backend/.env（.env 已在 .gitignore 中，不会提交）
#   2) 真实运行入口（必须带 --env-file，uvicorn 不会自动读取 .env）：
#        python -m uvicorn backend.app.alpha:app --port 8000 --env-file backend/.env
#      Mock 联调入口（无需 Qwen Key、无需审核资料）：
#        python -m uvicorn backend.app.dev:app --port 8000
#
# Beta 约定：
#   - 本机单进程运行，不需要 PostgreSQL/云服务器；
#   - 会话使用 InMemoryConversationStore，重启后历史清空；
#   - 变量名称与 backend/app/config.py、backend/services/qwen_client.py 一致。
#
# 注意：
#   - 不要把真实 API Key 写入本模板或任何提交内容；
#   - 本文件只提供配置样例，留空项使用代码中的默认值；
#   - 不得把 CORS_ALLOW_ORIGINS 配成 "*"。
# ============================================================

# ------------------------------------------------------------
# CORS（可选）
# 允许访问后端的前端来源，逗号分隔，必须带 http/https 协议。
# 代码默认已覆盖 Vite(5173)、Node 开发服务器(3000)、Live Server(5500)。
# ------------------------------------------------------------
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------
# Qwen 模型服务（真实 Agent 必需）
# 未配置 QWEN_API_KEY 时：
#   - Mock Agent（backend.app.dev:app）仍可正常联调；
#   - 真实入口（backend.app.alpha:app）可启动，但问答返回
#     503 KNOWLEDGE_BASE_UNAVAILABLE / 配置错误，不会伪造回答。
# ------------------------------------------------------------

# 必填（真实调用时）：DashScope 或兼容 OpenAI 接口的 API Key。
# 只保存在本地 backend/.env 或系统环境变量中，禁止提交。
QWEN_API_KEY=

# 可选：OpenAI-compatible 服务地址，默认 DashScope。
# 必须是有效的 http(s) 地址。
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 可选：模型名称，默认 qwen-flash（需账号具备该模型权限）。
QWEN_MODEL=qwen-flash

# 可选：单次模型调用超时（秒），必须大于 0，默认 28。
QWEN_TIMEOUT_SECONDS=28

# 可选：失败重试次数，取值范围 0–3，默认 0。
QWEN_MAX_RETRIES=0

# ------------------------------------------------------------
# Alpha 正式知识库（真实入口使用）
# 只加载该目录下 retrieval_status=enabled 且已完成人工审核的
# DocumentPackage JSON；blocked、review_only 与测试替身不会进入
# 正式索引。相对路径以仓库根目录为基准。
# 目录缺失或没有已审核资料包时，服务仍可启动，但问答返回
# 503 KNOWLEDGE_BASE_UNAVAILABLE，不会改用原始测试资料。
# ------------------------------------------------------------
ALPHA_PACKAGE_DIR=knowledge_base/processed/alpha/approved

# ------------------------------------------------------------
# 服务端会话历史（按 conversation_id 隔离，仅内存保存）
# 只保留最近的完整问答轮次；奇数上限会向下取整为偶数。
# ------------------------------------------------------------
CONVERSATION_MAX_MESSAGES=12
CONVERSATION_HISTORY_CHAR_LIMIT=6000

# 全局内存会话清理：最大会话数、空闲回收时间、清理间隔（秒）
CONVERSATION_MAX_COUNT=1000
CONVERSATION_IDLE_SECONDS=3600
CONVERSATION_CLEANUP_INTERVAL_SECONDS=300
